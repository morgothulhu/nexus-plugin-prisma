{
  "name": "@morgothulhu/nexus-plugin-prisma",
  "version": "7.10.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Flavian Desverne <desverne@prisma.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/morgothulhu/nexus-plugin-prisma.git"
  },
  "contributors": [
    {
      "email": "francois@rleyh.com",
      "name": "Morgothulhu",
      "url": "https://github.com/morgothulhu"
    }
  ],
  "keywords": [
    "prisma",
    "nexus"
  ],
  "files": [
    "dist",
    "src",
    "scripts",
    "schema.js",
    "schema.d.ts",
    "typegen.js",
    "typegen.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@prisma/client": "7.10.1",
    "graphql": "^16.14.2",
    "nexus": "1.3.0"
  },
  "dependencies": {
    "@prisma/internals": "7.10.1",
    "endent": "2.1.0",
    "fs-jetpack": "5.1.0",
    "lodash": "4.18.1",
    "pluralize": "8.0.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@prisma-labs/prettier-config": "0.1.0",
    "@prisma/client": "7.10.1",
    "@prisma/generator-helper": "7.10.1",
    "@prisma/migrate": "7.10.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "^24.19.2",
    "@types/node-fetch": "2.6.13",
    "@types/pluralize": "0.0.33",
    "@types/semver": "7.8.0",
    "cash-rm": "0.2.0",
    "get-port": "7.2.0",
    "graphql": "^16.14.2",
    "graphql-request": "7.4.0",
    "graphql-scalars": "2.0.1",
    "graphql-yoga": "6.0.1",
    "jest": "30.5.2",
    "jest-watch-typeahead": "3.0.1",
    "nexus": "1.3.0",
    "node-fetch": "3.3.2",
    "npm-check": "6.0.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "ts-jest": "29.4.15",
    "ts-morph": "28.0.0",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "typescript": "^6.0.3"
  },
  "prettier": "@prisma-labs/prettier-config",
  "scripts": {
    "clean": "rm -rf dist",
    "update:all": "npm-check . --save-exact --skip-unused --update-all --ignore \"{@types/node,camelcase,get-port,graphql}\"",
    "build": "yarn clean && yarn build:deps-sync && yarn build:module-facades && tsc",
    "build:deps-sync": "node scripts/ensure-deps-sync",
    "build:module-facades": "node scripts/build-module-facades",
    "build:ci": "tsc",
    "dev": "yarn -s build:module-facades && tsc --watch",
    "prepublishOnly": "yarn -s build",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'examples/**/*.ts'",
    "postinstall": "node ./scripts/postinstall.js",
    "test": "yarn test:run && yarn test:clean",
    "test:clean": "rm -rf tests/tmp",
    "test:run": "jest --forceExit",
    "test:run:rebaseSnapshots": "jest --forceExit --updateSnapshot",
    "test:dev": "jest src tests/ --watch",
    "upgrade-prisma-dev": "yarn add prisma @prisma/client@dev @prisma/generator-helper@dev @prisma/migrate@dev @prisma/sdk@dev"
  }
}
